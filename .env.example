# ================================================================
# DFAST ONLINE - CONFIGURAÇÃO DE AMBIENTE (.env)
# NUNCA ENVIE O ARQUIVO .env REAL PARA O GITHUB!
# ================================================================

# Porta do Servidor Local
PORT=3001

# Caminho do Banco de Dados SQLite (No HostGator, aponte para o caminho no servidor)
# Exemplo Local Windows: C:/Users/User/projetos/banco de dados Dfast/db_app.db
# Exemplo HostGator: /home/seu_usuario/database/db_app.db
DATABASE_PATH=C:/Users/User/projetos/banco de dados Dfast/db_app.db

# ================================================================
# CREDENCIAIS DA API MERCADO LIVRE (OBRIGATÓRIO PARA SINCRONIZAÇÃO)
# Obtenha em: https://developers.mercadolivre.com.br
# ================================================================
ML_APP_ID=seu_app_id_aqui
ML_SECRET_KEY=seu_client_secret_aqui
ML_REDIRECT_URI=https://seudominio.com.br/api/mercadolivre/callback
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_SELLER_ID=

# Horário Limite de Despacho no Mesmo Dia (Formato HH:mm)
FLEX_CUTOFF_HOUR=14:00
COLETA_CUTOFF_HOUR=16:00
